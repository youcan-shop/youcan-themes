{% comment %}
  Render a product media (images)

  Usage:
  {% render 'misc.product-media' %}
{% endcomment %}

<ui-carousel class="media" data-layout="carousel" ui-product="media">
  {% if product.images.size > 1 %}
    <button
      class="arrow"
      ui-carousel="arrow-previous"
      ui-slot="button"
      data-size="lg"
      data-as-icon
      aria-label="Previous"
    >
      {% render 'misc.icon', name: 'hgi-arrow-left-01' %}
    </button>
  {% endif %}
  <div class="main-media" ui-carousel="wrapper" ui-slot="carousel" aria-orientation="vertical" data-align="center">
    {% if product.images.size %}
      {% for image in product.images %}
        <div ui-carousel="item" ui-slot="carousel-item">
          {% if image contains 'youtube.com/vi' %}
            {% assign youtube_video_id = image | split: '/' | slice: -2 | first %}
            {% assign youtube_video_url = 'https://www.youtube.com/watch?v=' | append: youtube_video_id %}
            {{ youtube_video_url | external_video_url | external_video_tag: title: product.name, loading: 'lazy' }}
          {% else %}
            <img
              src="{{ image }}"
              alt="{{ product.name }}"
              height="100%"
              width="100%"
              {% if forloop.first %}
                loading="eager"
                fetchpriority="high"
              {% else %}
                loading="lazy"
              {% endif %}
            >
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      {% render 'misc.image-fallback', icon_size: 60 %}
    {% endif %}
  </div>
  {% if product.images.size > 1 %}
    <button
      class="arrow"
      ui-carousel="arrow-next"
      ui-slot="button"
      data-size="lg"
      data-as-icon
      aria-label="Next"
    >
      {% render 'misc.icon', name: 'hgi-arrow-right-01' %}
    </button>
    <div class="markers" ui-slot="carousel" aria-orientation="vertical" data-align="center">
      {% for marker in product.images %}
        <button
          class="marker"
          ui-carousel="marker"
          ui-slot="carousel-item"
          {% if forloop.first %}
            aria-selected="true"
          {% endif %}
        >
          <img
            src="{{ marker }}"
            alt="{{ product.name }}"
            height="100%"
            width="100%"
            loading="lazy"
          >
        </button>
      {% endfor %}
    </div>
  {% endif %}
</ui-carousel>
{% if section.settings.media_desktop_layout == 'grid' %}
  <div class="media" data-layout="grid">
    {% if product.images.size %}
      {% for image in product.images %}
        <div class="image">
          {% if image contains 'youtube.com/vi' %}
            {% assign youtube_video_id = image | split: '/' | slice: -2 | first %}
            {% assign youtube_video_url = 'https://www.youtube.com/watch?v=' | append: youtube_video_id %}
            {{ youtube_video_url | external_video_url | external_video_tag: title: product.name, loading: 'lazy' }}
          {% else %}
            <img
              src="{{ image }}"
              alt="{{ product.name }}"
              height="100%"
              width="100%"
              loading="eager"
              {% if forloop.first %}
                fetchpriority="high"
              {% endif %}
            >
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <div class="image">
        {% render 'misc.image-fallback', icon_size: 60 %}
      </div>
    {% endif %}
  </div>
{% endif %}
