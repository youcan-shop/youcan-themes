{%- liquid
  assign td_heading = block.settings.heading
  if td_heading contains 't:defaults.'
    assign td_heading = td_heading | remove_first: 't:' | t
  endif
  assign td_content = block.settings.content
  if td_content contains 't:defaults.'
    assign td_content = td_content | remove_first: 't:' | t
  endif
-%}
<details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.youcan_attributes }} data-block-id="{{ block.id }}">
  <summary class="accordion__summary">
    <span class="accordion__heading">
      {%- if block.settings.icon != 'none' -%}
        {% render 'icon', name: block.settings.icon, px: 20 %}
      {%- endif -%}
      {{ td_heading | escape }}
    </span>
    {% render 'icon', name: 'chevron-down', px: 18 %}
  </summary>
  <div class="accordion__content rte">
    {{ td_content }}
    {% content_for 'blocks' %}
  </div>
</details>

{% render 'custom-css', css: block.settings.custom_css, block_id: block.id %}

{% stylesheet %}
  .accordion__heading { display: inline-flex; align-items: center; gap: var(--space-xs); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.accordion_row",
  "tag": null,
  "blocks": [{ "type": "@theme" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "t:defaults.accordion_heading" },
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "check-circle", "label": "t:options.icons.check" },
        { "value": "truck", "label": "t:options.icons.truck" },
        { "value": "return", "label": "t:options.icons.return" },
        { "value": "shield", "label": "t:options.icons.shield" },
        { "value": "lock", "label": "t:options.icons.lock" },
        { "value": "gift", "label": "t:options.icons.gift" },
        { "value": "heart", "label": "t:options.icons.heart" },
        { "value": "star", "label": "t:options.icons.star" },
        { "value": "sparkle", "label": "t:options.icons.sparkle" },
        { "value": "leaf", "label": "t:options.icons.leaf" },
        { "value": "tag", "label": "t:options.icons.tag" },
        { "value": "clock", "label": "t:options.icons.clock" },
        { "value": "chat", "label": "t:options.icons.chat" },
        { "value": "mail", "label": "t:options.icons.mail" },
        { "value": "phone", "label": "t:options.icons.phone" },
        { "value": "map-pin", "label": "t:options.icons.map_pin" },
        { "value": "user", "label": "t:options.icons.user" },
        { "value": "cart", "label": "t:options.icons.cart" },
        { "value": "info", "label": "t:options.icons.info" }
      ],
      "default": "none"
    },
    { "type": "richtext", "id": "content", "label": "t:settings.content", "default": "t:defaults.accordion_content" },
    { "type": "checkbox", "id": "open", "label": "t:settings.open_by_default", "default": false },
    { "type": "header", "content": "t:content.advanced" },
    { "type": "textarea", "id": "custom_css", "label": "t:settings.custom_css", "placeholder": "color: #e1116f;" },
    { "type": "paragraph", "content": "t:info.custom_css_block" }
  ],
  "presets": [
    { "name": "t:names.accordion_row" }
  ]
}
{% endschema %}
