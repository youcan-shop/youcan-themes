{% assign pg = block.settings.page | default: closest.page | default: page %}

<div class="page-content-block" {{ block.youcan_attributes }} data-block-id="{{ block.id }}">
  {% if pg %}
    {% if block.settings.show_title %}
      <h2 class="h3">{{ pg.name }}</h2>
    {% endif %}
    <div class="rte">{{ pg.content }}</div>
  {% else %}
    <p class="text-muted">{{ 'page_content.placeholder' | t }}</p>
  {% endif %}
</div>

{% render 'custom-css', css: block.settings.custom_css, block_id: block.id %}

{% stylesheet %}
  .page-content-block { display: grid; gap: var(--space-md); width: 100%; max-width: 72ch; text-align: start; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page_content",
  "tag": null,
  "settings": [
    { "type": "page", "id": "page", "label": "t:settings.page" },
    { "type": "checkbox", "id": "show_title", "label": "t:settings.show_title", "default": true },
    { "type": "header", "content": "t:content.advanced" },
    { "type": "textarea", "id": "custom_css", "label": "t:settings.custom_css", "placeholder": "color: #e1116f;" },
    { "type": "paragraph", "content": "t:info.custom_css_block" }
  ],
  "presets": [
    { "name": "t:names.page_content", "category": "t:categories.text" }
  ]
}
{% endschema %}
