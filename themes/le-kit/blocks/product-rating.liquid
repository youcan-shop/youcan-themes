{% assign p = closest.product | default: product %}

{% if p and p.averageRating > 0 %}
  {% assign rating = p.averageRating | round %}
  <div class="rating product-rating" {{ block.youcan_attributes }}>
    <span class="product-rating__stars" aria-hidden="true">
      {% for i in (1..5) %}
        <span {% if i > rating %}class="product-rating__star--empty"{% endif %}>{% render 'icon', name: 'star', px: 16 %}</span>
      {% endfor %}
    </span>
    <span>{{ p.averageRating }} / 5</span>
  </div>
{% endif %}

{% stylesheet %}
  .product-rating__stars { display: inline-flex; }
  .product-rating__star--empty { opacity: 0.25; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.rating",
  "tag": null,
  "settings": [],
  "presets": [
    { "name": "t:names.rating", "category": "t:categories.product" }
  ]
}
{% endschema %}
