{%- liquid
  assign p = closest.product | default: product
  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'product.description' | t
  endif
-%}

{% if p.description != blank %}
  {% if block.settings.collapsible %}
    <details class="accordion product-description" {% if block.settings.open %}open{% endif %} {{ block.youcan_attributes }}>
      <summary class="accordion__summary">
        {{ heading | escape }}
        {% render 'icon', name: 'chevron-down', px: 18 %}
      </summary>
      <div class="accordion__content rte">{{ p.description }}</div>
    </details>
  {% else %}
    <div class="product-description rte" {{ block.youcan_attributes }}>{{ p.description }}</div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "t:names.product_description",
  "tag": null,
  "settings": [
    { "type": "checkbox", "id": "collapsible", "label": "t:settings.collapsible", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "visible_if": { "setting_id": "collapsible", "value": true }
    },
    {
      "type": "checkbox",
      "id": "open",
      "label": "t:settings.open_by_default",
      "default": true,
      "visible_if": { "setting_id": "collapsible", "value": true }
    }
  ],
  "presets": [
    { "name": "t:names.product_description", "category": "t:categories.product" }
  ]
}
{% endschema %}
