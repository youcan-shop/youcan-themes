{% assign menu = block.settings.menu %}

<nav class="menu-block" aria-label="{{ block.settings.heading | default: menu.title | escape }}" {{ block.youcan_attributes }}>
  {% if block.settings.heading != blank %}
    <p class="menu-block__heading h6">{{ block.settings.heading | escape }}</p>
  {% endif %}
  {% if menu.links.size > 0 %}
    <ul class="menu-block__list" role="list">
      {% for link in menu.links %}
        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}
</nav>

{% stylesheet %}
  .menu-block { display: grid; gap: var(--space-sm); }
  .menu-block__list { display: grid; gap: var(--space-xs); font-size: var(--text-sm); }
  .menu-block__list a { color: var(--color-muted); text-decoration: none; }
  .menu-block__list a:hover { color: var(--color-foreground); text-decoration: underline; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.menu",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "t:defaults.menu_heading" },
    { "type": "link_list", "id": "menu", "label": "t:settings.menu", "default": "main-menu" }
  ],
  "presets": [
    { "name": "t:names.menu", "category": "t:categories.navigation" }
  ]
}
{% endschema %}
