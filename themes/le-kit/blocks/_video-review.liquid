{% assign p = block.settings.product %}

<div class="video-review" data-carousel-item {{ block.youcan_attributes }}>
  <ui-video-card class="media video-review__media" style="--ratio: var(--video-ratio, 9 / 16);">
    {% if block.settings.video != blank %}
      <video
        src="{{ block.settings.video }}"
        {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 800 }}"{% endif %}
        preload="metadata"
        playsinline
        loop
        muted
      ></video>
      <button class="video-review__toggle" type="button" aria-label="{{ 'accessibility.play_video' | t }}">
        {% render 'icon', name: 'play', px: 22 %}
      </button>
    {% elsif block.settings.poster != blank %}
      {% render 'image', image: block.settings.poster, alt: '', sizes: '(min-width: 750px) 25vw, 60vw' %}
    {% else %}
      {{ 'hero-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </ui-video-card>
  {% if p %}
    <a class="video-review__product" href="{{ p.url }}">
      <span class="media video-review__thumb" style="--ratio: 1 / 1;">
        {% render 'image', image: p.preview_image, alt: '', width: 120, sizes: '40px', placeholder: 'product-1' %}
      </span>
      <span class="video-review__product-info">
        <span class="video-review__product-name">{{ p.name }}</span>
        {% render 'price', product: p, class: 'text-xs' %}
      </span>
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .video-review { display: grid; gap: var(--space-sm); }
  .video-review__media { border-radius: var(--radius-surface); }
  .video-review__media video { width: 100%; height: 100%; object-fit: cover; }
  .video-review__toggle {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    border: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.24), transparent 40%);
    color: #fff;
    cursor: pointer;
  }
  .video-review__toggle .icon { filter: drop-shadow(0 1px 4px rgb(0 0 0 / 0.4)); }
  ui-video-card[data-playing] .video-review__toggle { background: none; }
  ui-video-card[data-playing] .video-review__toggle .icon { opacity: 0; }
  .video-review__product {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-surface);
    box-shadow: var(--shadow-xs);
    text-decoration: none;
  }
  .video-review__thumb { flex: 0 0 40px; border-radius: var(--radius-input); }
  .video-review__product-info { display: grid; min-width: 0; }
  .video-review__product-name { overflow: hidden; font-size: var(--text-sm); font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.video_review",
  "tag": null,
  "settings": [
    { "type": "url", "id": "video", "label": "t:settings.video_file_url", "info": "t:info.video_review_url" },
    { "type": "image_picker", "id": "poster", "label": "t:settings.cover_image" },
    { "type": "product", "id": "product", "label": "t:settings.product" }
  ],
  "presets": [
    { "name": "t:names.video_review" }
  ]
}
{% endschema %}
