{%- liquid
  assign style = block.settings.style
  assign label = block.settings.label
  if label contains 't:defaults.'
    assign label = label | remove_first: 't:' | t
  endif
-%}

<ui-countdown
  class="countdown countdown--{{ style }} countdown--{{ block.settings.size }}{% if style == 'bar' %} color-{{ block.settings.color_scheme }} color-scheme{% endif %}"
  end="{{ block.settings.end_date | strip }}T{{ block.settings.end_time | default: '23:59' | strip }}"
  {% if block.settings.hide_when_expired %}hide-when-expired{% endif %}
  {{ block.youcan_attributes }} data-block-id="{{ block.id }}"
>
  {% if style == 'bar' and label != blank %}
    <span class="countdown__title">
      {% render 'icon', name: 'clock', px: 18 %}
      {{ label | escape }}
    </span>
  {% endif %}
  <span class="countdown__units">
    {% assign units = 'days,hours,minutes,seconds' | split: ',' %}
    {% for unit in units %}
      {% assign label_key = 'countdown.' | append: unit %}
      {% if style == 'bar' %}{% assign label_key = label_key | append: '_short' %}{% endif %}
      <span class="countdown__unit">
        <span class="countdown__value" ref="{{ unit }}">00</span>
        {% if block.settings.show_labels %}
          <span class="countdown__label">{{ label_key | t }}</span>
        {% endif %}
      </span>
      {% unless forloop.last or style == 'boxed' %}<span class="countdown__separator" aria-hidden="true">:</span>{% endunless %}
    {% endfor %}
  </span>
</ui-countdown>

<script type="module" src="{{ 'countdown.js' | asset_url }}"></script>

{% render 'custom-css', css: block.settings.custom_css, block_id: block.id %}

{% stylesheet %}
  .countdown, .countdown__units { display: inline-flex; align-items: flex-start; gap: var(--space-xs); font-variant-numeric: tabular-nums; }
  .countdown__unit { display: grid; justify-items: center; gap: 2px; }
  .countdown__value { font-family: var(--font-heading-family); font-weight: 600; line-height: 1; }
  .countdown__label { color: var(--color-muted); font-size: var(--text-xs); }
  .countdown__separator { font-weight: 600; line-height: 1; opacity: 0.4; }
  .countdown--sm .countdown__value, .countdown--sm .countdown__separator { font-size: var(--text-lg); }
  .countdown--md .countdown__value, .countdown--md .countdown__separator { font-size: var(--h4); }
  .countdown--lg .countdown__value, .countdown--lg .countdown__separator { font-size: var(--h2); }
  .countdown--boxed .countdown__unit {
    min-width: 64px;
    padding: var(--space-sm) var(--space-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-surface);
    background: var(--color-background);
    box-shadow: var(--shadow-xs);
  }
  .countdown--boxed.countdown--sm .countdown__unit { min-width: 52px; padding: var(--space-xs); }

  .countdown--bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    width: 100%;
    min-height: 54px;
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-box);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: var(--text-sm);
  }
  .countdown--bar .countdown__title { display: inline-flex; align-items: center; gap: var(--space-xs); font-weight: 500; }
  .countdown--bar .countdown__units { align-items: baseline; gap: 6px; }
  .countdown--bar .countdown__unit { display: inline-flex; align-items: baseline; gap: 4px; }
  .countdown--bar .countdown__value { font-family: inherit; font-size: var(--text-lg); font-weight: 500; }
  .countdown--bar .countdown__label { color: inherit; font-size: var(--text-sm); opacity: 0.8; }
  .countdown--bar .countdown__separator { font-size: var(--text-sm); font-weight: 400; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.countdown",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "t:settings.label", "default": "t:defaults.countdown_label" },
    { "type": "paragraph", "content": "t:info.countdown_label" },
    { "type": "text", "id": "end_date", "label": "t:settings.end_date", "placeholder": "2026-12-31" },
    { "type": "paragraph", "content": "t:info.end_date" },
    { "type": "text", "id": "end_time", "label": "t:settings.end_time", "default": "23:59" },
    { "type": "paragraph", "content": "t:info.end_time" },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "options": [
        { "value": "boxed", "label": "t:options.boxed" },
        { "value": "plain", "label": "t:options.plain" },
        { "value": "bar", "label": "t:options.bar" }
      ],
      "default": "boxed"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:settings.size",
      "options": [
        { "value": "sm", "label": "t:options.small" },
        { "value": "md", "label": "t:options.medium" },
        { "value": "lg", "label": "t:options.large" }
      ],
      "default": "md"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3",
      "visible_if": { "setting_id": "style", "value": "bar" }
    },
    { "type": "checkbox", "id": "show_labels", "label": "t:settings.show_labels", "default": true },
    { "type": "checkbox", "id": "hide_when_expired", "label": "t:settings.hide_when_expired", "default": false },
    { "type": "header", "content": "t:content.advanced" },
    { "type": "textarea", "id": "custom_css", "label": "t:settings.custom_css", "placeholder": "color: #e1116f;" },
    { "type": "paragraph", "content": "t:info.custom_css_block" }
  ],
  "presets": [
    { "name": "t:names.countdown", "category": "t:categories.basic" }
  ]
}
{% endschema %}
