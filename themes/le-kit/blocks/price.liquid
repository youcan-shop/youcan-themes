{% assign p = closest.product | default: product %}

{% if p %}
  <div class="price-block text-{{ block.settings.size }}" {{ block.youcan_attributes }} data-block-id="{{ block.id }}">
    {% render 'price', product: p, show_badge: block.settings.show_badge %}
  </div>
{% endif %}

{% render 'custom-css', css: block.settings.custom_css, block_id: block.id %}

{% schema %}
{
  "name": "t:names.price",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "size",
      "label": "t:settings.size",
      "options": [
        { "value": "md", "label": "t:options.medium" },
        { "value": "lg", "label": "t:options.large" },
        { "value": "xl", "label": "t:options.extra_large" }
      ],
      "default": "lg"
    },
    { "type": "checkbox", "id": "show_badge", "label": "t:settings.show_sale_badge", "default": true },
    { "type": "header", "content": "t:content.advanced" },
    { "type": "textarea", "id": "custom_css", "label": "t:settings.custom_css", "placeholder": "color: #e1116f;" },
    { "type": "paragraph", "content": "t:info.custom_css_block" }
  ],
  "presets": [
    { "name": "t:names.price", "category": "t:categories.product" }
  ]
}
{% endschema %}
