{% comment %}
  Renders a product price with an optional compare-at price.

  Accepts:
  - product: {Object} Product
  - show_compare: {Boolean} (Optional) Show the compare-at price, defaults to true
  - show_badge: {Boolean} (Optional) Show a "save x%" badge
  - class: {String} (Optional) Extra classes

  Usage:
  {% render 'price', product: product %}
{% endcomment %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign price = variant.price | default: product.price | default: 0
  assign compare_at_price = variant.compare_at_price | default: product.compare_at_price
  assign on_sale = false
  if compare_at_price and compare_at_price > price
    assign on_sale = true
  endif
-%}

<div class="price{% if on_sale %} price--on-sale{% endif %} {{ class }}" data-price>
  <span class="price__current" data-product-price>{{ price | money }}</span>
  {% unless show_compare == false %}
    <s class="price__compare" data-product-compare-price {% unless on_sale %}hidden{% endunless %}>
      {%- if on_sale %}{{ compare_at_price | money }}{% endif -%}
    </s>
  {% endunless %}
  {% if show_badge %}
    {% assign percentage = 0 %}
    {% if on_sale %}
      {% assign percentage = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round %}
    {% endif %}
    <span class="badge badge--sale" data-product-save {% unless on_sale %}hidden{% endunless %}>
      -<span data-product-save-value>{{ percentage }}</span>%
    </span>
  {% endif %}
</div>
