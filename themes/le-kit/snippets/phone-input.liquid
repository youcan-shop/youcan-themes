{% comment %}
  Renders a phone field with a country code picker and validation (libphonenumber).

  Accepts:
  - field: {Object} Phone checkout field

  Usage:
  {% render 'phone-input', field: field %}
{% endcomment %}

<ui-phone-input>
  <label class="field">
    <input type="hidden" name="{{ field.name }}" ref="hiddenInput">
    <span class="field__label">{{ field.display_name }}</span>
    <div class="input phone-input" dir="ltr">
      <div class="phone-input__country">
        <span class="phone-input__code" ref="displayedCode"></span>
        {% render 'icon', name: 'chevron-down', px: 14 %}
        <select
          class="select"
          name="phone_country_code"
          autocomplete="tel-country-code"
          aria-label="{{ 'checkout.country_code' | t }}"
          data-select-compact
          ref="countrySelect"
        ></select>
      </div>
      <input
        type="{{ field.type }}"
        inputmode="tel"
        name="phone_number"
        placeholder="{{ field.placeholder }}"
        autocomplete="tel-national"
        ref="number"
        {% if field.required %}required{% endif %}
      >
    </div>
    <span class="phone-input__error" data-hidden="true" ref="error">
      {{ 'errors.invalid_phone_number' | t }}
    </span>
  </label>
</ui-phone-input>
