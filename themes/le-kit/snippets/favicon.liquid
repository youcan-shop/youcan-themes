{% comment %}
  Renders the favicon. Falls back to an SVG with the store initials in the primary color.

  Usage:
  {% render 'favicon' %}
{% endcomment %}

{% if settings.favicon %}
  <link rel="icon" href="{{ settings.favicon | image_url: width: 96, height: 96, crop: 'center' }}">
{% else %}
  {% assign initials = store.name | strip | slice: 0, 2 | upcase | default: 'ST' %}
  {% assign color = settings.color_schemes['scheme-1'].settings.primary | default: '#121212' | remove: '#' %}
  {% capture favicon -%}
    data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='48' height='48' viewBox='0 0 48 48'><rect width='100%' height='100%' rx='10' fill='%23{{ color }}'/><text x='50%' y='50%' font-family='system-ui,sans-serif' font-size='22' font-weight='600' fill='white' text-anchor='middle' dy='8'>{{ initials | escape }}</text></svg>
  {%- endcapture %}
  <link rel="icon" type="image/svg+xml" href="{{ favicon }}">
{% endif %}
