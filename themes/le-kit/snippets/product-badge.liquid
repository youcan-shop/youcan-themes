{% comment %}
  Renders the promotional badge of a product card, based on the "Badges" theme settings.

  Accepts:
  - product: {Object} Product
  - price: {Number} Current price
  - compare_at_price: {Number} Compare-at price

  Usage:
  {% render 'product-badge', product: product, price: price, compare_at_price: compare_at_price %}
{% endcomment %}

{% case settings.badge_type %}
  {% when 'discount-percentage' %}
    {% if compare_at_price and compare_at_price > price %}
      {% assign percentage = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round %}
      <span class="badge badge--sale">-{{ percentage }}%</span>
    {% endif %}
  {% when 'discount-amount' %}
    {% if compare_at_price and compare_at_price > price %}
      {% assign saving = compare_at_price | minus: price %}
      <span class="badge badge--sale">{{ 'product.save' | t }} {{ saving | money }}</span>
    {% endif %}
  {% when 'low-stock' %}
    {% assign inventory = product.selected_or_first_available_variant.inventory %}
    {% if product.isTrackingInventory and inventory > 0 and inventory <= settings.badge_threshold %}
      <span class="badge">{{ 'product.low_stock' | t | replace: '[count]', inventory }}</span>
    {% endif %}
  {% when 'custom-text' %}
    {% assign badge_text = settings.badge_text %}
    {% if badge_text contains 't:defaults.' %}{% assign badge_text = badge_text | remove_first: 't:' | t %}{% endif %}
    {% if badge_text != blank %}
      <span class="badge">{{ badge_text | escape }}</span>
    {% endif %}
{% endcase %}
