{% comment %}
  Renders an empty state

  Accepts:
  - type: {String} cart | search | collection | collections
  - icon: {String} (Optional) Icon name

  Usage:
  {% render 'empty-state', type: 'cart' %}
{% endcomment %}

{%- liquid
  case type
    when 'cart'
      assign icon = icon | default: 'cart'
      assign url = '/collections'
    when 'search'
      assign icon = icon | default: 'search'
      assign url = '/collections'
    when 'collection'
      assign icon = icon | default: 'tag'
      assign url = '/collections'
    else
      assign icon = icon | default: 'tag'
      assign url = '/'
  endcase
  assign heading_key = 'empty.' | append: type | append: '.heading'
  assign text_key = 'empty.' | append: type | append: '.text'
  assign button_key = 'empty.' | append: type | append: '.button'
-%}

<div class="empty-state">
  <span class="empty-state__icon">{% render 'icon', name: icon, px: 24 %}</span>
  <h2 class="h5">{{ heading_key | t }}</h2>
  <p class="text-sm">{{ text_key | t }}</p>
  <a class="button button--secondary" href="{{ url }}">{{ button_key | t }}</a>
</div>
