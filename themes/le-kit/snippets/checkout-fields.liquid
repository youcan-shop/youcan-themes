{% comment %}
  Renders the store's checkout fields for express checkout forms.

  Accepts:
  - form: {Object} (Optional) The express checkout form, to keep the values and mark the fields of a failed post

  Usage:
  {% render 'checkout-fields', form: form %}
{% endcomment %}

{% assign linked_fields = 'country,region,city' %}
{% assign has_linked_fields = checkout.linked_fields %}
{% assign has_phone_validation = checkout.phone_validation %}

<div class="checkout-fields">
  {% for field in checkout.fields %}
    {%- liquid
      assign field_name = field.name
      assign error_key = field.name
      assign field_value = form[field.name] | default: field.default_value
      if field.custom
        assign field_name = 'extra_fields[' | append: field.name | append: ']'
        assign error_key = 'extra_fields.' | append: field.name
        assign field_value = form.extra_fields[field.name] | default: field.default_value
      endif
      assign field_error = form.errors.messages[error_key]
    -%}

    {% unless has_linked_fields and linked_fields contains field.name %}
      {% if field.name == 'phone' and has_phone_validation %}
        {% render 'phone-input', field: field %}
      {% elsif field.type == 'hidden' %}
        <input type="hidden" name="{{ field_name }}" value="{{ field.default_value }}">
      {% else %}
        <label class="field" {% if field_error %}error-message="{{ field_error | escape }}"{% endif %}>
          <span class="field__label">{{ field.display_name }}</span>
          {% case field.type %}
            {% when 'textarea' %}
              <textarea
                class="textarea"
                name="{{ field_name }}"
                placeholder="{{ field.placeholder }}"
                {% if field.required %}required{% endif %}
              >{{ field_value | escape }}</textarea>
            {% when 'select' %}
              <select class="select" name="{{ field_name }}" {% if field.required %}required{% endif %}>
                {% for option in field.options %}
                  <option value="{{ option }}" {% if option == field_value %}selected{% endif %}>{{ option }}</option>
                {% endfor %}
              </select>
            {% else %}
              <input
                class="input"
                type="{{ field.type }}"
                name="{{ field_name }}"
                value="{{ field_value | escape }}"
                placeholder="{{ field.placeholder }}"
                {% if field.required %}required{% endif %}
              >
          {% endcase %}
        </label>
      {% endif %}
    {% endunless %}
  {% endfor %}

  {% if has_linked_fields %}
    {% render 'linked-fields', fields: checkout.fields %}
  {% endif %}
</div>
