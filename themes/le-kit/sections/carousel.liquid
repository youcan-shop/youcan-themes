{%- liquid
  assign td_heading = section.settings.heading
  if td_heading contains 't:defaults.'
    assign td_heading = td_heading | remove_first: 't:' | t
  endif
-%}
{%- liquid
  assign s = section.settings
  assign arrows = false
  if s.show_arrows
    assign arrows = true
  endif
-%}

<div
  class="section color-scheme color-{{ s.color_scheme }}"
  style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;"
>
  <ui-carousel
    class="carousel-section{% if s.width == 'page' %} page-width{% endif %}"
    data-all-items
    style="--per-page: {{ s.columns }}; --per-page-mobile: {{ s.columns_mobile | plus: 0.15 }}; --slider-gap: {{ s.gap }}px;"
    {% if s.autoplay %}autoplay interval="{{ s.speed | times: 1000 }}"{% endif %}
  >
    <div class="{% if s.width == 'full' %}page-width{% endif %}">
      {% render 'section-header', heading: td_heading, description: s.description, arrows: arrows, alignment: s.header_alignment %}
    </div>
    <div class="slider__track carousel-section__track{% if s.width == 'full' %} carousel-section__track--full{% endif %}" ref="track">
      {% content_for 'blocks' %}
    </div>
  </ui-carousel>
</div>

{% stylesheet %}
  .carousel-section__track > * { min-width: 0; }
  .carousel-section__track--full { padding-inline: var(--page-gutter); scroll-padding-inline: var(--page-gutter); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.carousel",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "t:settings.heading", "default": "t:defaults.carousel_heading" },
    { "type": "text", "id": "description", "label": "t:settings.description" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:settings.header_alignment",
      "options": [
        { "value": "start", "label": "t:options.start" },
        { "value": "center", "label": "t:options.center" }
      ],
      "default": "start"
    },
    { "type": "header", "content": "t:content.layout" },
    { "type": "range", "id": "columns", "label": "t:settings.columns_desktop", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "t:settings.columns_mobile", "min": 1, "max": 2, "step": 1, "default": 1 },
    { "type": "range", "id": "gap", "label": "t:settings.gap", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 16 },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        { "value": "page", "label": "t:options.page" },
        { "value": "full", "label": "t:options.full_width" }
      ],
      "default": "page"
    },
    { "type": "checkbox", "id": "show_arrows", "label": "t:settings.show_arrows", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "t:settings.autoplay", "default": false },
    { "type": "range", "id": "speed", "label": "t:settings.change_every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5, "visible_if": { "setting_id": "autoplay", "value": true } },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    {
      "name": "t:names.carousel",
      "category": "t:categories.layout",
      "blocks": [
        { "type": "group", "settings": { "padding": 24, "border": true, "rounded": true, "gap": 12 }, "blocks": [{ "type": "image", "settings": { "ratio": "landscape" } }, { "type": "heading", "settings": { "tag": "h3", "size": "h5" } }, { "type": "text", "settings": { "size": "sm", "muted": true } }] },
        { "type": "group", "settings": { "padding": 24, "border": true, "rounded": true, "gap": 12 }, "blocks": [{ "type": "image", "settings": { "ratio": "landscape" } }, { "type": "heading", "settings": { "tag": "h3", "size": "h5" } }, { "type": "text", "settings": { "size": "sm", "muted": true } }] },
        { "type": "group", "settings": { "padding": 24, "border": true, "rounded": true, "gap": 12 }, "blocks": [{ "type": "image", "settings": { "ratio": "landscape" } }, { "type": "heading", "settings": { "tag": "h3", "size": "h5" } }, { "type": "text", "settings": { "size": "sm", "muted": true } }] },
        { "type": "group", "settings": { "padding": 24, "border": true, "rounded": true, "gap": 12 }, "blocks": [{ "type": "image", "settings": { "ratio": "landscape" } }, { "type": "heading", "settings": { "tag": "h3", "size": "h5" } }, { "type": "text", "settings": { "size": "sm", "muted": true } }] }
      ]
    }
  ]
}
{% endschema %}
