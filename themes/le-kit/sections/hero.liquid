{%- liquid
  assign s = section.settings
-%}

<div
  class="hero color-scheme color-{{ s.color_scheme }}{% if s.width == 'page' %} hero--boxed page-width{% endif %}"
  data-height="{{ s.height }}"
  data-overlay="{{ s.overlay_style }}"
  style="--overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }}; --section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;"
>
  <div class="hero__media media" aria-hidden="true">
    {% if s.video != blank %}
      {% render 'video-player', url: s.video, mode: 'background', poster: s.image, sizes: '100vw', eager: true, class: 'hero__video' %}
    {% elsif s.image != blank %}
      {% if s.image_mobile != blank %}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
          {% render 'image', image: s.image, alt: '', sizes: '100vw', eager: true, width: 2400 %}
        </picture>
      {% else %}
        {% render 'image', image: s.image, alt: '', sizes: '100vw', eager: true, width: 2400 %}
      {% endif %}
    {% else %}
      {{ 'hero-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <div class="hero__content section{% unless s.width == 'page' %} page-width{% endunless %}">
    <div class="layout-panel hero__panel" {% render 'layout-style', settings: s %}>
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% render 'custom-css', css: section.settings.custom_css, section_id: section.id %}

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    isolation: isolate;
    overflow: hidden;
  }
  .hero > * { grid-area: 1 / 1; }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--overlay-opacity, 0);
  }
  .hero[data-overlay="gradient"] .hero__media::after {
    background: linear-gradient(to top, #000 0%, rgb(0 0 0 / 0.6) 30%, transparent 70%);
  }
  .hero__media picture, .hero__media img, .hero__media video, .hero__video { width: 100%; height: 100%; object-fit: cover; }
  .hero--boxed { background: none; }
  .hero--boxed .hero__media { inset-inline: var(--page-gutter); border-radius: var(--radius-surface); overflow: hidden; }
  .hero--boxed .hero__content { padding-inline: clamp(20px, 4vw, 56px); }
  .hero__content { display: flex; }
  .hero__panel { max-width: var(--hero-content-width, 100%); }
  .hero[data-height="small"] .hero__content { min-height: 360px; }
  .hero[data-height="medium"] .hero__content { min-height: 520px; }
  .hero[data-height="large"] .hero__content { min-height: 680px; }
  .hero[data-height="screen"] .hero__content { min-height: calc(100svh - var(--header-height)); }
  @media (max-width: 749px) {
    .hero[data-height="small"] .hero__content { min-height: 280px; }
    .hero[data-height="medium"] .hero__content { min-height: 420px; }
    .hero[data-height="large"] .hero__content { min-height: 540px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
