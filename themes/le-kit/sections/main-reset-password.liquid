<div
  class="section color-scheme color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width auth">
    <div class="auth__card">
      <header class="auth__header">
        <h1 class="h3">{{ 'account.reset.title' | t }}</h1>
        <p class="text-sm text-muted">{{ 'account.reset.text' | t }}</p>
      </header>
      {% form 'reset_customer_password' %}
        <div class="auth__form">
        {% render 'form-errors', form: form %}
        <label class="field">
          <span class="field__label">{{ 'account.new_password' | t }}</span>
          <input placeholder="{{ 'placeholders.new_password' | t }}" class="input" type="password" name="password" minlength="6" maxlength="72" autocomplete="new-password" required>
          <span class="text-xs text-muted">{{ 'account.password_hint' | t }}</span>
        </label>
        <label class="field">
          <span class="field__label">{{ 'account.password_confirmation' | t }}</span>
          <input placeholder="{{ 'placeholders.password_confirmation' | t }}" class="input" type="password" name="password_confirmation" minlength="6" maxlength="72" autocomplete="new-password" required>
        </label>
          <button class="button button--full" type="submit">{{ 'account.reset.submit' | t }}</button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.customer_reset_password",
  "templates": ["customer-reset-password"],
  "limit": 1,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
