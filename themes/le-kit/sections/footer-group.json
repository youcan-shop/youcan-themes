{
  "type": "footer",
  "name": "Footer",
  "sections": {
    "footer": {
      "type": "footer",
      "blocks": {
        "brand": {
          "type": "group",
          "settings": { "gap": 12 },
          "blocks": {
            "logo": { "type": "logo", "settings": {} },
            "about": { "type": "text", "settings": { "size": "sm", "muted": true, "text": "<p>A short sentence about your store, what you sell and why customers love it.</p>" } },
            "social": { "type": "social-links", "settings": {} }
          },
          "order": ["logo", "about", "social"]
        },
        "menu": {
          "type": "menu",
          "settings": { "heading": "t:defaults.menu_heading", "menu": "main-menu" }
        },
        "about": {
          "type": "menu",
          "settings": { "heading": "t:defaults.menu_about_heading", "menu": "footer-about" }
        },
        "help": {
          "type": "menu",
          "settings": { "heading": "t:defaults.menu_help_heading", "menu": "footer-contact" }
        },
        "newsletter": {
          "type": "group",
          "settings": { "gap": 12 },
          "blocks": {
            "newsletter_heading": { "type": "text", "settings": { "text": "<p>Subscribe to our newsletter to be the first to learn about new products, promotions and special offers.</p>" } },
            "newsletter_form": { "type": "email-signup", "settings": {} }
          },
          "order": ["newsletter_heading", "newsletter_form"]
        }
      },
      "order": ["newsletter", "menu", "about", "help", "brand"],
      "settings": {}
    },
    "footer-utilities": {
      "type": "footer-utilities",
      "settings": { "menu": "footer-terms" }
    }
  },
  "order": ["footer", "footer-utilities"]
}
