{
  "type": "footer",
  "name": "Footer",
  "sections": {
    "footer": {
      "type": "footer",
      "blocks": {
        "brand": {
          "type": "group",
          "settings": { "gap": 12 },
          "blocks": {
            "logo": { "type": "logo", "settings": {} },
            "about": { "type": "text", "settings": { "size": "sm", "muted": true, "text": "<p>A short sentence about your store, what you sell and why customers love it.</p>" } },
            "social": { "type": "social-links", "settings": {} }
          },
          "order": ["logo", "about", "social"]
        },
        "menu": {
          "type": "menu",
          "settings": { "heading": "Shop", "menu": "main-menu" }
        },
        "about": {
          "type": "menu",
          "settings": { "heading": "About", "menu": "footer-about" }
        },
        "help": {
          "type": "menu",
          "settings": { "heading": "Help", "menu": "footer-contact" }
        },
        "newsletter": {
          "type": "group",
          "settings": { "gap": 12 },
          "blocks": {
            "newsletter_heading": { "type": "heading", "settings": { "tag": "p", "size": "h6", "heading": "Join our newsletter" } },
            "newsletter_form": { "type": "email-signup", "settings": {} }
          },
          "order": ["newsletter_heading", "newsletter_form"]
        }
      },
      "order": ["brand", "menu", "about", "help", "newsletter"],
      "settings": {}
    },
    "footer-utilities": {
      "type": "footer-utilities",
      "settings": { "menu": "footer-terms" }
    }
  },
  "order": ["footer", "footer-utilities"]
}
