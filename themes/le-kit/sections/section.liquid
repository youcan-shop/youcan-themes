{%- liquid
  assign s = section.settings
-%}

<div
  class="section section-container color-scheme color-{{ s.color_scheme }}"
  data-height="{{ s.height }}"
  style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px; --overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};"
>
  {% if s.background_image != blank %}
    <div class="section-container__background media" aria-hidden="true">
      {% render 'image', image: s.background_image, alt: '', sizes: '100vw' %}
    </div>
  {% endif %}
  <div class="section-container__inner{% if s.width == 'page' %} page-width{% else %} section-container__inner--full{% endif %}">
    <div class="layout-panel" {% render 'layout-style', settings: s %}>
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.section",
  "class": "section-wrapper",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "header", "content": "t:content.layout" },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        { "value": "column", "label": "t:options.vertical" },
        { "value": "row", "label": "t:options.horizontal" }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.stack_on_mobile",
      "default": true,
      "visible_if": { "setting_id": "content_direction", "value": "row" }
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.horizontal_alignment",
      "options": [
        { "value": "flex-start", "label": "t:options.start" },
        { "value": "center", "label": "t:options.center" },
        { "value": "flex-end", "label": "t:options.end" },
        { "value": "space-between", "label": "t:options.space_between" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.vertical_alignment",
      "options": [
        { "value": "flex-start", "label": "t:options.top" },
        { "value": "center", "label": "t:options.middle" },
        { "value": "flex-end", "label": "t:options.bottom" },
        { "value": "space-between", "label": "t:options.space_between" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    { "type": "header", "content": "t:content.size" },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        { "value": "page", "label": "t:options.page" },
        { "value": "full", "label": "t:options.full_width" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        { "value": "auto", "label": "t:options.auto" },
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" },
        { "value": "screen", "label": "t:options.full_screen" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "background_image", "label": "t:settings.background_image" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    {
      "name": "t:names.section",
      "category": "t:categories.layout",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    },
    {
      "name": "t:names.rich_text",
      "category": "t:categories.text",
      "settings": { "padding_top": 64, "padding_bottom": 64 },
      "blocks": [
        { "type": "heading", "settings": { "max_width": "normal" } },
        { "type": "text", "settings": { "muted": true } },
        { "type": "button" }
      ]
    },
    {
      "name": "t:names.multicolumn",
      "category": "t:categories.layout",
      "settings": { "gap": 32, "horizontal_alignment": "flex-start" },
      "blocks": [
        { "type": "heading" },
        {
          "type": "group",
          "settings": { "content_direction": "row", "gap": 24 },
          "blocks": [
            { "type": "group", "blocks": [{ "type": "image", "settings": { "ratio": "landscape" } }, { "type": "heading", "settings": { "tag": "h3", "size": "h5" } }, { "type": "text", "settings": { "muted": true } }] },
            { "type": "group", "blocks": [{ "type": "image", "settings": { "ratio": "landscape" } }, { "type": "heading", "settings": { "tag": "h3", "size": "h5" } }, { "type": "text", "settings": { "muted": true } }] },
            { "type": "group", "blocks": [{ "type": "image", "settings": { "ratio": "landscape" } }, { "type": "heading", "settings": { "tag": "h3", "size": "h5" } }, { "type": "text", "settings": { "muted": true } }] }
          ]
        }
      ]
    },
    {
      "name": "t:names.icons_with_text",
      "category": "t:categories.text",
      "settings": { "content_direction": "row", "horizontal_alignment": "space-between", "vertical_alignment": "flex-start", "gap": 24, "padding_top": 32, "padding_bottom": 32 },
      "blocks": [
        { "type": "group", "settings": { "horizontal_alignment": "center", "gap": 8 }, "blocks": [{ "type": "icon", "settings": { "icon": "truck", "size": 32 } }, { "type": "heading", "settings": { "tag": "h3", "size": "h6", "heading": "t:defaults.feature_shipping" } }, { "type": "text", "settings": { "size": "sm", "muted": true, "text": "t:defaults.feature_shipping_text" } }] },
        { "type": "group", "settings": { "horizontal_alignment": "center", "gap": 8 }, "blocks": [{ "type": "icon", "settings": { "icon": "return", "size": 32 } }, { "type": "heading", "settings": { "tag": "h3", "size": "h6", "heading": "t:defaults.feature_returns" } }, { "type": "text", "settings": { "size": "sm", "muted": true, "text": "t:defaults.feature_returns_text" } }] },
        { "type": "group", "settings": { "horizontal_alignment": "center", "gap": 8 }, "blocks": [{ "type": "icon", "settings": { "icon": "lock", "size": 32 } }, { "type": "heading", "settings": { "tag": "h3", "size": "h6", "heading": "t:defaults.feature_payment" } }, { "type": "text", "settings": { "size": "sm", "muted": true, "text": "t:defaults.feature_payment_text" } }] }
      ]
    },
    {
      "name": "t:names.faq",
      "category": "t:categories.text",
      "settings": { "gap": 24 },
      "blocks": [
        { "type": "heading", "settings": { "heading": "t:defaults.faq_heading" } },
        { "type": "group", "settings": { "width": "fill" }, "blocks": [{ "type": "accordion", "blocks": [
          { "type": "_accordion-row", "settings": { "heading": "t:defaults.faq_question_1" } },
          { "type": "_accordion-row", "settings": { "heading": "t:defaults.faq_question_2" } },
          { "type": "_accordion-row", "settings": { "heading": "t:defaults.faq_question_3" } }
        ] }] }
      ]
    },
    {
      "name": "t:names.newsletter",
      "category": "t:categories.forms",
      "settings": { "color_scheme": "scheme-2", "padding_top": 64, "padding_bottom": 64 },
      "blocks": [
        { "type": "heading", "settings": { "heading": "t:defaults.newsletter_heading" } },
        { "type": "text", "settings": { "muted": true, "text": "t:defaults.newsletter_text" } },
        { "type": "email-signup" }
      ]
    },
    {
      "name": "t:names.countdown",
      "category": "t:categories.banners",
      "settings": { "color_scheme": "scheme-2", "padding_top": 64, "padding_bottom": 64, "gap": 20 },
      "blocks": [
        { "type": "heading", "settings": { "heading": "t:defaults.countdown_heading" } },
        { "type": "text", "settings": { "muted": true, "text": "t:defaults.countdown_text" } },
        { "type": "countdown" },
        { "type": "button", "settings": { "label": "t:defaults.shop_now", "link": "/collections" } }
      ]
    },
    {
      "name": "t:names.video",
      "category": "t:categories.media",
      "blocks": [
        { "type": "heading" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
