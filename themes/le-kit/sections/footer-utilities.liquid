{%- liquid
  assign year = 'now' | date: '%Y'
  assign copyright = section.settings.copyright | replace: '[year]', year | replace: '[store]', store.name
-%}

<div class="footer-utilities color-scheme color-{{ section.settings.color_scheme }}">
  <div class="page-width footer-utilities__inner">
    <p class="footer-utilities__copyright">{{ copyright }}</p>
    {% if section.settings.menu.links.size > 0 %}
      <ul class="footer-utilities__links" role="list">
        {% for link in section.settings.menu.links %}
          <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .footer-utilities__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-md);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .footer-utilities__links { display: flex; flex-wrap: wrap; gap: var(--space-md); padding: 0; list-style: none; }
  .footer-utilities__links a { text-decoration: none; }
  .footer-utilities__links a:hover { color: var(--color-foreground); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer_utilities",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "copyright", "label": "t:settings.copyright", "default": "© [year] [store]", "info": "t:info.copyright" },
    { "type": "link_list", "id": "menu", "label": "t:settings.policies_menu" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-2" }
  ],
  "presets": [
    { "name": "t:names.footer_utilities" }
  ]
}
{% endschema %}
