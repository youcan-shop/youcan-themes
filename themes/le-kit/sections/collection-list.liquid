{%- liquid
  assign td_heading = section.settings.heading
  if td_heading contains 't:defaults.'
    assign td_heading = td_heading | remove_first: 't:' | t
  endif
-%}
{%- liquid
  assign s = section.settings
  case s.ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '1 / 1'
  endcase
  assign arrows = false
  if s.layout == 'carousel'
    assign arrows = true
  endif
  assign link = blank
  if s.show_view_all
    assign link = '/collections'
  endif
-%}

<div
  class="section color-scheme color-{{ s.color_scheme }}"
  style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;"
>
  <ui-carousel
    class="page-width collection-list"
    style="--per-page: {{ s.columns }}; --per-page-mobile: {{ s.columns_mobile | plus: 0.15 }};"
    {% unless s.layout == 'carousel' %}data-static{% endunless %}
  >
    {% render 'section-header',
      heading: td_heading,
      description: s.description,
      link: link,
      arrows: arrows,
      alignment: s.header_alignment
    %}

    <ul
      class="{% if s.layout == 'carousel' %}slider__track{% else %}grid grid--{{ s.layout }}{% endif %}"
      style="--columns: {{ s.columns }}; --columns-mobile: {{ s.columns_mobile }};"
      role="list"
      ref="track"
    >
      {% if s.collections.size > 0 %}
        {% for collection in s.collections %}
          <li data-carousel-item>
            {% render 'collection-card', collection: collection, ratio: ratio, style: s.card_style, sizes: '(min-width: 750px) 33vw, 50vw' %}
          </li>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <li data-carousel-item>
            {% render 'collection-card', collection: blank, ratio: ratio, style: s.card_style, placeholder_index: forloop.index0 %}
          </li>
        {% endfor %}
      {% endif %}
    </ul>
  </ui-carousel>
</div>

{% schema %}
{
  "name": "t:names.collection_list",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "t:settings.heading", "default": "t:defaults.collections_heading" },
    { "type": "text", "id": "description", "label": "t:settings.description" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:settings.header_alignment",
      "options": [
        { "value": "start", "label": "t:options.start" },
        { "value": "center", "label": "t:options.center" }
      ],
      "default": "start"
    },
    { "type": "collection_list", "id": "collections", "label": "t:settings.collections", "limit": 12 },
    { "type": "checkbox", "id": "show_view_all", "label": "t:settings.show_view_all", "default": false },
    { "type": "header", "content": "t:content.layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        { "value": "grid", "label": "t:options.grid" },
        { "value": "carousel", "label": "t:options.carousel" },
        { "value": "bento", "label": "t:options.bento" },
        { "value": "editorial", "label": "t:options.editorial" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "columns", "label": "t:settings.columns_desktop", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "t:settings.columns_mobile", "min": 1, "max": 2, "step": 1, "default": 2 },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        { "value": "square", "label": "t:options.square" },
        { "value": "portrait", "label": "t:options.portrait" },
        { "value": "landscape", "label": "t:options.landscape" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:settings.title_position",
      "options": [
        { "value": "below", "label": "t:options.below_image" },
        { "value": "overlay", "label": "t:options.on_image" }
      ],
      "default": "below"
    },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    { "name": "t:names.collection_list", "category": "t:categories.collections" },
    { "name": "t:names.collections_bento", "category": "t:categories.collections", "settings": { "layout": "bento", "card_style": "overlay", "columns": 4 } },
    { "name": "t:names.collections_editorial", "category": "t:categories.collections", "settings": { "layout": "editorial", "ratio": "portrait" } }
  ]
}
{% endschema %}
