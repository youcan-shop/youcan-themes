{%- liquid
  assign scheme = section.settings.color_scheme
-%}

<div
  class="section color-scheme color-{{ scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <ui-product
    class="product-main product-main--media-{{ section.settings.media_position }} product-main--media-{{ section.settings.media_width }}{% if section.settings.full_width %} product-main--full{% else %} page-width{% endif %}{% unless section.settings.sticky_info %} product-main--static-info{% endunless %}"
    product-id="{{ product.id }}"
    data-product-main
  >
    <script type="application/json" ref="variants">{{ product.variants | json }}</script>

    <div class="product-main__media">
      {% content_for 'block', type: '_product-media', id: 'media' %}
    </div>

    <div class="product-main__info">
      <div class="layout-panel product-main__details" style="--gap: {{ section.settings.gap }}px;">
        {% content_for 'blocks' %}
      </div>
    </div>
  </ui-product>
</div>

{% if product %}
  <script type="application/json" data-product-view>{{ product | json }}</script>
  {% javascript %}
    document.addEventListener("DOMContentLoaded", () => {
      const data = document.querySelector("[data-product-view]");
      if (data && window.Dotshop?.pixels) window.Dotshop.pixels.publish("view-content", JSON.parse(data.textContent));
    });
  {% endjavascript %}
{% endif %}

{% render 'custom-css', css: section.settings.custom_css, section_id: section.id %}

{% schema %}
{
  "name": "t:names.product_information",
  "templates": ["product"],
  "limit": 1,
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "select",
      "id": "media_position",
      "label": "t:settings.media_position",
      "options": [
        { "value": "start", "label": "t:options.start" },
        { "value": "end", "label": "t:options.end" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "t:settings.media_width",
      "options": [
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" }
      ],
      "default": "large"
    },
    { "type": "range", "id": "gap", "label": "t:settings.gap", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "checkbox", "id": "full_width", "label": "t:settings.full_width", "default": true },
    { "type": "paragraph", "content": "t:info.product_full_width" },
    { "type": "checkbox", "id": "sticky_info", "label": "t:settings.sticky_info", "default": true },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "t:content.advanced" },
    { "type": "textarea", "id": "custom_css", "label": "t:settings.custom_css", "placeholder": "h2 { color: #e1116f; }" },
    { "type": "paragraph", "content": "t:info.custom_css_section" }
  ],
  "presets": [
    {
      "name": "t:names.product_information",
      "blocks": [
        { "type": "breadcrumbs" },
        { "type": "product-title" },
        { "type": "price" },
        { "type": "product-rating" },
        { "type": "variant-picker" },
        { "type": "product-inventory" },
        { "type": "buy-buttons" },
        { "type": "product-description", "settings": { "collapsible": true } }
      ]
    }
  ]
}
{% endschema %}
