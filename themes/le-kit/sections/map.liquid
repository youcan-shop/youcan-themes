{%- liquid
  assign s = section.settings
  case s.ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    else
      assign ratio = '4 / 3'
  endcase
  assign embed = s.embed | strip
  if embed contains '<iframe'
    assign embed_src = embed | split: 'src="' | last | split: '"' | first
  else
    assign embed_src = embed
  endif
-%}

<div
  class="section color-scheme color-{{ s.color_scheme }}"
  style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;"
>
  <div class="page-width media-content__grid media-content__grid--{{ s.map_position }}">
    <div class="media map__frame" style="--ratio: {{ ratio }};">
      {% if embed_src contains 'google.com/maps' %}
        <iframe
          src="{{ embed_src }}"
          title="{{ 'accessibility.map' | t }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      {% else %}
        <div class="map__placeholder">
          {% render 'icon', name: 'map-pin', px: 32 %}
          <p class="text-sm text-muted">{{ 'map.placeholder' | t }}</p>
        </div>
      {% endif %}
    </div>
    <div class="media-content__content">
      <div class="layout-panel" {% render 'layout-style', settings: s %}>
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% render 'custom-css', css: section.settings.custom_css, section_id: section.id %}

{% stylesheet %}
  .map__frame { border: 1px solid var(--color-border); border-radius: var(--radius-surface); }
  .map__frame iframe { width: 100%; height: 100%; border: 0; }
  .map__placeholder { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: var(--space-xs); padding: var(--space-lg); text-align: center; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.map",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "textarea", "id": "embed", "label": "t:settings.map_embed", "placeholder": "https://www.google.com/maps/embed?pb=..." },
    { "type": "paragraph", "content": "t:info.map_embed" },
    {
      "type": "select",
      "id": "map_position",
      "label": "t:settings.media_position",
      "options": [
        { "value": "start", "label": "t:options.start" },
        { "value": "end", "label": "t:options.end" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        { "value": "landscape", "label": "t:options.landscape" },
        { "value": "square", "label": "t:options.square" },
        { "value": "portrait", "label": "t:options.portrait" }
      ],
      "default": "landscape"
    },
    { "type": "header", "content": "t:content.layout" },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        { "value": "column", "label": "t:options.vertical" },
        { "value": "row", "label": "t:options.horizontal" }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.stack_on_mobile",
      "default": true,
      "visible_if": { "setting_id": "content_direction", "value": "row" }
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.horizontal_alignment",
      "options": [
        { "value": "flex-start", "label": "t:options.start" },
        { "value": "center", "label": "t:options.center" },
        { "value": "flex-end", "label": "t:options.end" },
        { "value": "space-between", "label": "t:options.space_between" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.vertical_alignment",
      "options": [
        { "value": "flex-start", "label": "t:options.top" },
        { "value": "center", "label": "t:options.middle" },
        { "value": "flex-end", "label": "t:options.bottom" },
        { "value": "space-between", "label": "t:options.space_between" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "t:content.advanced" },
    { "type": "textarea", "id": "custom_css", "label": "t:settings.custom_css", "placeholder": "h2 { color: #e1116f; }" },
    { "type": "paragraph", "content": "t:info.custom_css_section" }
  ],
  "presets": [
    {
      "name": "t:names.map",
      "category": "t:categories.media",
      "blocks": [
        { "type": "heading", "settings": { "heading": "t:defaults.map_heading" } },
        { "type": "text", "settings": { "muted": true, "text": "t:defaults.map_text" } },
        { "type": "button", "settings": { "label": "t:defaults.get_directions", "style": "secondary", "new_tab": true } }
      ]
    }
  ]
}
{% endschema %}
