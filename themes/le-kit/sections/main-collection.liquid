{%- liquid
  assign s = section.settings
  assign card_vw = 100 | divided_by: s.columns
  assign card_vw_mobile = 100 | divided_by: s.columns_mobile
  assign sizes = '(min-width: 990px) ' | append: card_vw | append: 'vw, ' | append: card_vw_mobile | append: 'vw'
-%}

<div
  class="section color-scheme color-{{ s.color_scheme }}"
  style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;"
>
  <div class="page-width listing">
    {% paginate collection.products by 24 cod, category_id: category.id %}
      <header class="listing__header">
        {% if s.show_breadcrumbs %}
          <nav class="breadcrumbs" aria-label="{{ 'accessibility.breadcrumbs' | t }}">
            <ol>
              <li><a href="/">{{ 'general.home' | t }}</a></li>
              <li><a href="/collections">{{ 'collections.title' | t }}</a></li>
              <li aria-current="page">{{ category.name }}</li>
            </ol>
          </nav>
        {% endif %}
        {% if s.show_image and category.image != blank %}
          <div class="media listing__banner" style="--ratio: 3 / 1;">
            {% render 'image', image: category.image, alt: category.name, sizes: '100vw', eager: true %}
          </div>
        {% endif %}
        <h1 class="listing__title">{{ category.name }}</h1>
        {% if s.show_description and category.description != blank %}
          <div class="rte text-muted listing__description">{{ category.description }}</div>
        {% endif %}
      </header>

      <div class="listing__toolbar">
        {% if s.show_subcollections %}
          <ul class="listing__chips" role="list">
            {% if subCategories.size > 0 %}
              <li><a class="chip" href="/collections/{{ category.slug }}" aria-current="page">{{ 'general.all' | t }}</a></li>
              {% for sub in subCategories %}
                <li><a class="chip" href="/collections/{{ sub.slug }}">{{ sub.name }}</a></li>
              {% endfor %}
            {% else %}
              {% for item in collections limit: 12 %}
                <li><a class="chip" href="/collections/{{ item.slug }}" {% if item.id == category.id %}aria-current="page"{% endif %}>{{ item.name }}</a></li>
              {% endfor %}
            {% endif %}
          </ul>
        {% endif %}
        <div class="listing__meta">
          <p class="text-sm text-muted">{{ 'collections.products_count' | t | replace: '[count]', total }}</p>
          {% if s.show_sort %}
            {% render 'sort', url: previous_page %}
          {% endif %}
        </div>
      </div>

      {% if items.size > 0 %}
        <ul class="grid" style="--columns: {{ s.columns }}; --columns-mobile: {{ s.columns_mobile }};" role="list">
          {% for product in items %}
            {% assign eager = false %}
            {% if forloop.index <= s.columns %}{% assign eager = true %}{% endif %}
            <li>{% content_for 'block', type: '_product-card', id: 'product-card', card_product: product, sizes: sizes, eager: eager %}</li>
          {% endfor %}
        </ul>
        {% render 'pagination', current: current, last: last, previous_page: previous_page, next_page: next_page %}
      {% else %}
        {% render 'empty-state', type: 'collection' %}
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% render 'custom-css', css: section.settings.custom_css, section_id: section.id %}

{% schema %}
{
  "name": "t:names.collection_products",
  "blocks": [{ "type": "_product-card" }],
  "templates": ["collection"],
  "limit": 1,
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "t:settings.show_breadcrumbs", "default": false },
    { "type": "checkbox", "id": "show_description", "label": "t:settings.show_description", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "t:settings.show_collection_image", "default": false },
    { "type": "checkbox", "id": "show_subcollections", "label": "t:settings.show_subcollections", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "t:settings.show_sort", "default": true },
    { "type": "range", "id": "columns", "label": "t:settings.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "t:settings.columns_mobile", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "t:content.advanced" },
    { "type": "textarea", "id": "custom_css", "label": "t:settings.custom_css", "placeholder": "h2 { color: #e1116f; }" },
    { "type": "paragraph", "content": "t:info.custom_css_section" }
  ]
}
{% endschema %}
