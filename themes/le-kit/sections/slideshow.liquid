<div
  class="slideshow-wrapper{% if section.settings.width == 'page' %} page-width{% endif %}"
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
<ui-carousel
  class="slideshow color-scheme color-{{ section.settings.color_scheme }}{% if section.settings.width == 'page' %} slideshow--boxed{% endif %}"
  data-height="{{ section.settings.height }}"
  {% if section.settings.autoplay %}autoplay interval="{{ section.settings.speed | times: 1000 }}"{% endif %}
  aria-roledescription="carousel"
  aria-label="{{ 'accessibility.slideshow' | t }}"
>
  <div class="slider__track slideshow__track" data-carousel-track>
    {% content_for 'blocks' %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="slideshow__controls page-width">
      {% if section.settings.show_arrows %}
      <button class="button button--secondary button--icon" type="button" data-carousel-prev aria-label="{{ 'accessibility.previous' | t }}">
        {% render 'icon', name: 'chevron-left', class: 'icon--flip' %}
      </button>
      {% endif %}
      {% if section.settings.show_dots %}
      <div class="slideshow__dots">
        {% for b in section.blocks %}
          <button
            class="slider__dot"
            type="button"
            data-carousel-dot
            aria-label="{{ 'accessibility.go_to_slide' | t | replace: '[index]', forloop.index }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          ></button>
        {% endfor %}
      </div>
      {% endif %}
      {% if section.settings.show_arrows %}
      <button class="button button--secondary button--icon" type="button" data-carousel-next aria-label="{{ 'accessibility.next' | t }}">
        {% render 'icon', name: 'chevron-right', class: 'icon--flip' %}
      </button>
      {% endif %}
    </div>
  {% endif %}
</ui-carousel>
</div>

{% stylesheet %}
  .slideshow { --slider-gap: 0px; position: relative; }
  .slideshow--boxed { overflow: hidden; border-radius: var(--radius-surface); }
  .slideshow__controls {
    position: absolute;
    inset-inline: 0;
    inset-block-end: var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    pointer-events: none;
  }
  .slideshow__controls > * { pointer-events: auto; }
  .slideshow__dots { display: flex; gap: 6px; color: #fff; }
  .slideshow .slider__dot { background-color: #fff; }
{% endstylesheet %}

