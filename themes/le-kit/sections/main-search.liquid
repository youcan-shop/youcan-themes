{%- liquid
  assign s = section.settings
  assign card_vw = 100 | divided_by: s.columns
  assign sizes = '(min-width: 990px) ' | append: card_vw | append: 'vw, 50vw'
-%}

<div
  class="section color-scheme color-{{ s.color_scheme }}"
  style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;"
>
  <div class="page-width listing">
    {% paginate search.products by 24 cod %}
      <header class="listing__header listing__header--search">
        <h1 class="h2">{{ 'search.title' | t }}</h1>
        <form class="search-form" action="/search" method="get" role="search">
          <label class="visually-hidden" for="search-input">{{ 'header.search' | t }}</label>
          <input class="input" id="search-input" type="search" name="q" value="{{ terms | escape }}" placeholder="{{ 'header.search_placeholder' | t }}">
          <button class="button" type="submit">{% render 'icon', name: 'search', px: 18 %} {{ 'search.submit' | t }}</button>
        </form>
      </header>

      {% if terms != blank %}
        <div class="listing__toolbar">
          <p class="text-sm text-muted">
            {{ 'search.results_for' | t | replace: '[count]', total | replace: '[terms]', terms | escape }}
          </p>
          {% render 'sort', url: previous_page, terms: terms %}
        </div>
      {% endif %}

      {% if items.size > 0 %}
        <ul class="grid" style="--columns: {{ s.columns }}; --columns-mobile: {{ s.columns_mobile }};" role="list">
          {% for product in items %}
            <li>{% render 'product-card', product: product, sizes: sizes %}</li>
          {% endfor %}
        </ul>
        {% render 'pagination', current: current, last: last, previous_page: previous_page, next_page: next_page %}
      {% elsif terms != blank %}
        {% render 'empty-state', type: 'search' %}
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.search_results",
  "templates": ["search"],
  "limit": 1,
  "settings": [
    { "type": "range", "id": "columns", "label": "t:settings.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "t:settings.columns_mobile", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
