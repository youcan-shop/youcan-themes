<div
  class="section color-scheme color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width cart-page">
    <h1 class="h2 cart-page__title">{{ 'cart.title' | t }}</h1>
    {% render 'cart-content', context: 'page', show_coupon: section.settings.show_coupon, summary_scheme: section.settings.summary_color_scheme %}
  </div>
</div>

{% render 'custom-css', css: section.settings.custom_css, section_id: section.id %}

{% schema %}
{
  "name": "t:names.cart",
  "templates": ["cart"],
  "limit": 1,
  "settings": [
    { "type": "checkbox", "id": "show_coupon", "label": "t:settings.show_coupon", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "summary_color_scheme", "label": "t:settings.summary_color_scheme", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "header", "content": "t:content.advanced" },
    { "type": "textarea", "id": "custom_css", "label": "t:settings.custom_css", "placeholder": "h2 { color: #e1116f; }" },
    { "type": "paragraph", "content": "t:info.custom_css_section" }
  ]
}
{% endschema %}
