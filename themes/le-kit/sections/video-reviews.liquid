{%- liquid
  assign s = section.settings
  case s.ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    else
      assign ratio = '9 / 16'
  endcase
-%}

<div
  class="section color-scheme color-{{ s.color_scheme }}"
  style="--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;"
>
  <ui-carousel class="page-width" style="--per-page: {{ s.columns }}; --per-page-mobile: 1.6; --video-ratio: {{ ratio }};">
    {% render 'section-header', heading: s.heading, description: s.description, arrows: true, alignment: s.header_alignment %}
    <div class="slider__track" data-carousel-track>
      {% content_for 'blocks' %}
    </div>
  </ui-carousel>
</div>

{% schema %}
{
  "name": "t:names.video_reviews",
  "max_blocks": 12,
  "blocks": [{ "type": "_video-review" }],
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "t:settings.heading", "default": "t:defaults.video_reviews_heading" },
    { "type": "text", "id": "description", "label": "t:settings.description" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:settings.header_alignment",
      "options": [
        { "value": "start", "label": "t:options.start" },
        { "value": "center", "label": "t:options.center" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        { "value": "story", "label": "t:options.story" },
        { "value": "portrait", "label": "t:options.portrait" },
        { "value": "square", "label": "t:options.square" }
      ],
      "default": "story"
    },
    { "type": "range", "id": "columns", "label": "t:settings.columns_desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:settings.padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "t:settings.padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    {
      "name": "t:names.video_reviews",
      "category": "t:categories.media",
      "blocks": [
        { "type": "_video-review" },
        { "type": "_video-review" },
        { "type": "_video-review" },
        { "type": "_video-review" }
      ]
    }
  ]
}
{% endschema %}
