<!doctype html>
{% assign lang = store.store_locale.iso_code %}
{% assign direction = 'ltr' %}

{% if lang == 'ar' %}
  {% assign direction = 'rtl' %}
{% endif %}

<html lang="{{ lang }}" dir="{{ direction }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ request.url }}">

    {% render 'config-title' %}

    {{ '_tokens.css' | asset_url | stylesheet_tag }}
    {{ '_misc.css' | asset_url | stylesheet_tag }}
    {{ 'ui.toast.css' | asset_url | stylesheet_tag }}
    {{ '_main.css' | asset_url | stylesheet_tag }}
    {{ '_checkout.css' | asset_url | stylesheet_tag }}
    {% render 'config-theme' %}
    {% render '_config' %}
  </head>
  <body
    data-checkout-template="pop"
    data-primary="{{ settings.primary_color.hex }}"
    {% if settings.theme_mode == 'auto' %}
      data-theme-mode="light"
    {% else %}
      data-theme-mode="{{ settings.theme_mode }}"
    {% endif %}
  >
    {% render 'ui-skip-to-content' %}
    {% render 'ui-loader' %}
    {% render 'ui-toast' %}

    <main layout="checkout" data-template="pop" theme="{{ settings.theme_style }}" id="main">
      {% section 'checkout-header' %}
      {{ content_for_layout }}
      {% section 'checkout-footer' %}
    </main>
    {{ content_for_footer }}
  </body>
</html>
