{{ 'section.account.css' | asset_url | stylesheet_tag }}

<div section="auth">
  <div class="card" data-wide>
    <div class="card-head">
      <h1 class="title">{{ 'account.reset.title' | t }}</h1>
      {% if request.url contains '/account/reset/' %}
        <p class="description">{{ 'account.reset.text' | t }}</p>
      {% endif %}
    </div>
    {% if request.url contains '/account/reset/' %}
      {% form 'reset_customer_password' %}
        {% render 'misc-form-errors', form: form %}
        <div class="fields">
          <div class="field">
            <label for="reset-password">{{ 'account.new_password' | t }}</label>
            <input
              id="reset-password"
              type="password"
              name="password"
              minlength="6"
              maxlength="72"
              placeholder="{{ 'placeholders.new_password' | t }}"
              autocomplete="new-password"
              required
            >
            <span class="hint">{{ 'account.password_hint' | t }}</span>
          </div>
          <div class="field">
            <label for="reset-password-confirmation">{{ 'account.password_confirmation' | t }}</label>
            <input
              id="reset-password-confirmation"
              type="password"
              name="password_confirmation"
              minlength="6"
              maxlength="72"
              placeholder="{{ 'placeholders.password_confirmation' | t }}"
              autocomplete="new-password"
              required
            >
          </div>
        </div>
        <button type="submit" ui-button data-variant="primary" data-size="md">
          {{ 'account.reset.submit' | t }}
        </button>
      {% endform %}
    {% else %}
      <div class="info" role="status">
        {% render 'ui-icon', name: 'mail' %}
        <span>{{ 'account.reset.open_email_link' | t }}</span>
      </div>
      <a
        href="{{ routes.account_recover_url | default: '/account/recover' }}"
        ui-button
        data-variant="tertiary"
        data-size="md"
      >
        {{ 'account.reset.request_new_link' | t }}
      </a>
    {% endif %}
  </div>
</div>

{%- schema -%}
{
  "label": "t:sections.customer_reset_password.label",
  "templates": ["customer-reset-password"],
  "limit": 1
}
{%- endschema -%}
