{{ 'section.checkout-header.css' | asset_url | stylesheet_tag }}

<header section="checkout-header">
  {% if section.settings.show_cart_link %}
    <a class="cart-link" href="{{ checkout.routes.cart }}" ui-link>
      {% render 'ui-icon', name: 'arrow_back', flip_in_rtl: true %}
      <span>{{ 'checkout.back_to_cart' | t }}</span>
    </a>
  {% endif %}

  <a class="logo" href="/" ui-link>
    {% if section.settings.logo.src %}
      <img
        src="{{ section.settings.logo.src }}"
        alt="{{ store.name }}"
        height="100%"
        width="{{ section.settings.logo_width }}"
        {% if section.settings.logo_invert %}
          data-invert
        {% endif %}
      >
    {% else %}
      {{ store.name }}
    {% endif %}
  </a>
</header>

{% schema %}
{
  "label": "t:sections.checkout_header.label",
  "tag": "div",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.checkout_header.logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.checkout_header.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.checkout_header.logo_width",
      "min": 40,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "logo_invert",
      "label": "t:sections.header.logo_invert",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.checkout_header.navigation"
    },
    {
      "type": "checkbox",
      "id": "show_cart_link",
      "label": "t:sections.checkout_header.show_cart_link",
      "default": true
    }
  ]
}
{% endschema %}
