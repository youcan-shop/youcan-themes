{{ 'ui.drawer.css' | asset_url | stylesheet_tag }}
{{ 'ui.search.css' | asset_url | stylesheet_tag }}
{{ 'ui.drawer.js' | asset_url | script_tag_deferred }}

{%- liquid
  assign account_url = routes.account_url | default: '/account'

  if customer
    assign account_label = 'account.title' | t
  else
    assign account_label = 'account.login.title' | t
  endif
-%}

<header
  layout="header"
  {% if section.settings.header_sticky %}
    data-sticky
  {% endif %}
  data-logo-position="{{ section.settings.desktop_logo_position }}"
>
  <ul class="links">
    {% for link in main-link-list.links %}
      <li class="link">
        <a href="{{ link.url }}" ui-link>
          {{ link.title }}
        </a>
        {% if link.links.size %}
          <div class="sub-links">
            {% for sub_link in link.links %}
              <a href="{{ sub_link.url }}" ui-button data-variant="secondary" data-size="sm">
                <span>{{ sub_link.title }}</span>
                {% render 'ui-icon', name: 'arrow_right_alt', flip_in_rtl: true %}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </li>
    {% endfor %}
    {% if settings.theme_mode == 'auto' %}
      {% render 'ui-theme' %}
    {% endif %}
  </ul>
  <div class="logo">
    <a href="/" ui-link>
      {% if section.settings.header_logo.src %}
        <img
          src="{{ section.settings.header_logo.src }}"
          style="object-position: {{ section.settings.header_logo.presentation.focal_point }}"
          alt="{{ store.name }}"
          height="100%"
          width="{{ section.settings.logo_width }}"
          {% if section.settings.logo_invert %}
            data-invert
          {% endif %}
        >
      {% else %}
        {{ store.name }}
      {% endif %}
    </a>
  </div>
  <ul class="actions">
    {% if section.settings.show_account %}
      <li data-account>
        <a class="action" href="{{ account_url }}" aria-label="{{ account_label }}">
          {% render 'ui-icon', name: 'person' %}
        </a>
      </li>
    {% endif %}
    <li>
      {% render 'ui-search' %}
    </li>
    <li>
      {% render 'ui-cart-drawer' %}
    </li>
    <li>
      {% render 'ui-menu-drawer', show_account: section.settings.show_account %}
    </li>
  </ul>
</header>

{% schema %}
{
  "label": "t:sections.header.label",
  "tag": "header",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.header.menu_links_paragraph"
    },
    {
      "type": "header",
      "content": "t:sections.header.logo"
    },
    {
      "type": "image_picker",
      "id": "header_logo",
      "label": "t:sections.header.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.header.width",
      "default": 40
    },
    {
      "type": "select",
      "id": "desktop_logo_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.header.logo_position_left"
        },
        {
          "value": "center",
          "label": "t:sections.header.logo_position_center"
        }
      ],
      "default": "left",
      "label": "t:sections.header.desktop_logo_position"
    },
    {
      "type": "checkbox",
      "id": "logo_invert",
      "label": "t:sections.header.logo_invert",
      "default": false
    },
    {
      "type": "header",
      "content": "t:common.style.style"
    },
    {
      "type": "checkbox",
      "id": "header_sticky",
      "label": "t:sections.header.sticky_mode",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:sections.header.show_account",
      "default": true
    }
  ]
}
{% endschema %}
