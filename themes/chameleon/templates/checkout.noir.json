{
  "label": "t:templates.checkout_noir",
  "layout": "checkout-noir",
  "sections": {
    "checkout-customer": {
      "type": "checkout-customer",
      "settings": {
        "gap": 16,
        "margin_bottom": 28,
        "input_label": "floating",
        "input_grouped": true
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "static": true,
          "settings": {
            "visible": false
          }
        },
        "contact": {
          "type": "contact",
          "static": true,
          "settings": {
            "show_title": false
          }
        },
        "shipping-address": {
          "type": "shipping-address",
          "static": true,
          "settings": {
            "show_title": false
          }
        }
      }
    },
    "checkout-shipping": {
      "type": "checkout-shipping",
      "settings": {
        "margin_bottom": 28
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "static": true,
          "settings": {
            "size": 15,
            "weight": "600"
          }
        }
      }
    },
    "checkout-payment": {
      "type": "checkout-payment",
      "settings": {
        "margin_bottom": 0
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "static": true,
          "settings": {
            "size": 15,
            "weight": "600"
          }
        },
        "pay-button": {
          "type": "pay-button",
          "static": true,
          "settings": {
            "height": 52,
            "radius": 10,
            "full_width": true,
            "show_total": true
          }
        },
        "legal-note": {
          "type": "legal-note",
          "static": true,
          "settings": {
            "alignment": "center"
          }
        }
      }
    },
    "checkout-summary": {
      "type": "checkout-summary",
      "settings": {
        "gap": 24,
        "margin_bottom": 0
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "static": true,
          "settings": {
            "visible": false
          }
        },
        "lines": {
          "type": "lines",
          "static": true,
          "settings": {
            "image_size": 48,
            "image_radius": 10
          }
        },
        "coupon": {
          "type": "coupon",
          "static": true,
          "settings": {
            "style": "link",
            "start_open": false
          }
        },
        "totals": {
          "type": "totals",
          "static": true,
          "settings": {
            "total_size": 20,
            "divider": "thin"
          }
        }
      }
    }
  },
  "order": ["checkout-customer", "checkout-shipping", "checkout-payment", "checkout-summary"]
}
