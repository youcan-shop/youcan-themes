        "border_width": 1,
        "radius": 4,
        "margin_bottom": 16,
        "input_label": "above",
        "input_grouped": false
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "static": true,
          "settings": {
            "size": 18,
            "weight": "600"
          }
        }
      }
    },
    "checkout-shipping": {
      "type": "checkout-shipping",
      "settings": {
        "padding_y": 24,
        "padding_x": 24,
        "border_width": 1,
        "radius": 4,
        "margin_bottom": 16
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "static": true,
          "settings": {
            "size": 18,
            "weight": "600"
          }
        },
        "methods": {
          "type": "methods",
          "static": true,
          "settings": {
            "style": "cards",
            "gap": 12
          }
        }
      }
    },
    "checkout-payment": {
      "type": "checkout-payment",
      "settings": {
        "padding_y": 24,
        "padding_x": 24,
        "border_width": 1,
        "radius": 4,
        "margin_bottom": 0
