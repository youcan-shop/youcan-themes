{% comment %}
  Renders menu drawer

  Accepts:
  - show_account: {Boolean} (optional) Render the customer account link

  Usage:
  {% render 'ui-menu-drawer', show_account: true %}
{% endcomment %}

{%- liquid
  assign account_url = routes.account_url | default: '/account'

  if customer
    assign account_label = 'account.title' | t
  else
    assign account_label = 'account.login.title' | t
  endif
-%}

<ui-drawer class="menu">
  <button class="drawer-trigger action" aria-expanded="false" aria-label="menu">
    {{ 'header.menu.name' | t }}
  </button>
  <div class="drawer-content" data-state="closed">
    <div class="header">
      <h6 class="title">{{ 'header.menu.name' | t }}</h6>
      <button ui-button data-variant="secondary" data-size="sm" as-icon aria-label="close">
        {% render 'ui-icon', name: 'close' %}
      </button>
    </div>
    <div class="main">
      <ul class="items">
        {% for link in main-link-list.links %}
          <li class="item">
            <a href="{{ link.url }}" ui-link>
              {{ link.title }}
            </a>
            {% if link.links.size %}
              <div class="item sub-links">
                {% for sub_link in link.links %}
                  <a href="{{ sub_link.url }}" ui-link>
                    {{ sub_link.title }}
                    {% render 'ui-icon', name: 'arrow_right_alt', flip_in_rtl: true %}
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      {% if show_account %}
        <a
          href="{{ account_url }}"
          ui-button
          data-variant="tertiary"
          data-size="md"
          aria-label="{{ account_label }}"
        >
          {% render 'ui-icon', name: 'person' %}
          <span>{{ account_label }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</ui-drawer>
