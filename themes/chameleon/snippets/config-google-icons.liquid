{% assign icon_names = 'ac_unit,add,alarm,apps,arrow_back,arrow_downward,arrow_forward,arrow_right_alt,arrow_upward,autorenew,badge,block,bolt,cached,call,call_made,cancel,celebration,chat,check_circle,chevron_backward,chevron_forward,chevron_left,chevron_right,circle,close,close_small,content_copy,credit_card,date_range,delete,diamond,directions_car,do_not_disturb,done_all,download,eco,edit,error,event,expand_less,expand_more,favorite,featured_seasonal_and_gifts,filter_alt,first_page,flight,forum,gavel,grid_view,groups,handshake,health_and_safety,help,history,home,image,info,inventory_2,kid_star,language,last_page,list,local_activity,local_shipping,location_on,lock,mail,map,menu,military_tech,more_horiz,package_2,payments,pedal_bike,pending,percent,playlist_add_check,print,public,recycling,redeem,remove,report,rocket_launch,savings,schedule,search,search_activity,sentiment_satisfied,share,shield,shopping_cart,sort,star,storefront,sunny,support_agent,sync,task_alt,thumb_up,timer,today,train,tune,update,upload,verified_user,visibility,warning,water_drop,web_stories,workspace_premium' %}
{% assign listed_icons = ',' | append: icon_names | append: ',' %}
{% assign custom_icons = '' %}

{% if icons %}
  {% assign requested_icons = icons | split: ',' %}
  {% for requested_icon in requested_icons %}
    {% assign name = requested_icon | strip %}
    {% assign needle = ',' | append: name | append: ',' %}
    {% assign known_icons = listed_icons | append: custom_icons | append: ',' %}
    {% unless name == blank or known_icons contains needle %}
      {% assign custom_icons = custom_icons | append: ',' | append: name %}
    {% endunless %}
  {% endfor %}
{% endif %}

{% unless icons and custom_icons == blank %}
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,200,0..1,0&icon_names={{ icon_names | append: custom_icons | escape }}"
    rel="stylesheet"
  >
{% endunless %}
