{{ 'misc.phone-validation.css' | asset_url | stylesheet_tag }}

{{ 'https://unpkg.com/libphonenumber-js@1.12.27/bundle/libphonenumber-min.js' | script_tag_deferred }}
{{ 'misc.phone-validation.js' | asset_url | script_tag_deferred }}


{% assign phone_name = name | default: field.name %}
{% assign phone_label = label | default: field.display_name %}
{% assign phone_type = type | default: field.type %}
{% if standalone %}
  {% assign phone_type = type | default: 'tel' %}
{% endif %}
{% assign phone_placeholder = placeholder | default: field.placeholder %}
{% assign phone_required = required | default: field.required %}

<ui-phone-validation{% if value %} data-initial-value="{{ value | escape }}"{% endif %}>
  <label {% if standalone %}ui-account-phone-field{% else %}ui-express-checkout-field{% endif %}>
    <input type="hidden" name="{{ phone_name }}" ui-phone-hidden-input>
    {% if standalone %}
      {% if phone_label %}<span ui-account-phone-label>{{ phone_label }}</span>{% endif %}
    {% else %}<span ui-express-checkout-label>{{ phone_label }}</span>{% endif %}
    <div ui-phone-input-wrapper>
      <div ui-phone-countries-wrapper>
        <span ui-phone-displayed-country-code></span>
        <select
          name="phone_country_code"
          autocomplete="tel-country-code"
          ui-phone-select-country-code
        ></select>
      </div>
      <input
        type="{{ phone_type }}"
        inputmode="tel"
        name="phone_number"
        placeholder="{{ phone_placeholder }}"
        autocomplete="tel-national"
        ui-phone-number
        {% if phone_required %}
          required
        {% endif %}
      >
    </div>
    <div style="display: none;" ui-phone-error>
      {{ 'error_messages.invalid_phone_number' | t }}
    </div>
  </label>
</ui-phone-validation>
