
<address>
  {% if address.name != blank %}
    <strong>{{ address.name }}</strong><br>
  {% endif %}
  {% if address.company != blank %}
    {{ address.company }}<br>
  {% endif %}
  {{ address.address1 }}{% if address.address2 != blank %}, {{ address.address2 }}{% endif %}<br>
  {{ address.city }}{% if address.province != blank %}, {{ address.province }}{% endif %}{% if address.zip != blank %} {{ address.zip }}{% endif %}<br>
  {{ address.country }}
  {% if address.phone != blank %}
    <br><span dir="ltr">{{ address.phone }}</span>
  {% endif %}
</address>
