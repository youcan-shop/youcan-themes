<button
  type="button"
  class="password-toggle"
  ui-button
  data-variant="ghost"
  data-size="sm"
  as-icon
  aria-pressed="false"
  aria-label="{{ 'account.show_password' | t }}"
  data-label-show="{{ 'account.show_password' | t }}"
  data-label-hide="{{ 'account.hide_password' | t }}"
>
  {% render 'ui-icon', name: 'visibility' %}
</button>
